# Copiare in .env e valorizzare. Il file .env non va mai nel repository.

# Credenziali AssoWeb (portale regionale)
APP_USERNAME_AVIS=
APP_PASSWORD_AVIS=

# Filtri salvati su AssoWeb (Ricerca e convocazione): i donatori da avvisare dei posti liberi e, per le prove, un
# filtro che trova solo l'operatore
ASSOWEB_FILTRO_POSTI_LIBERI=AvisAltopianoMessaggio
ASSOWEB_FILTRO_PROVA=test

# Browser dei portali: 0 = finestra visibile (default), 1 = headless. AssoWeb blocca il browser headless: lasciare 0
PORTALI_HEADLESS=0

# SIAN (AVIS Nazionale). Token del web service (libro soci): lo genera il Presidente sul portale SIAN, Gestione Utente,
# "Genera token per cooperazione applicativa". Vale solo in produzione. Il token contiene "$": va tra apici
# singoli, altrimenti docker compose lo interpreta come una variabile
SIAN_TOKEN=''

# Django: DEBUG=1 solo in sviluppo; SECRET_KEY lunga e casuale
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_HTTPS=0

# PostgreSQL (usate sia da Django sia da docker compose)
POSTGRES_DB=gestionale
POSTGRES_USER=gestionale
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Storico AssoAVIS (solo PC di sviluppo, per manage.py importa_assoavis). Vuoto = SQL Server locale,
# DB ASSOAVIS_STORICO, autenticazione Windows
# ASSOAVIS_ODBC=DRIVER={ODBC Driver 18 for SQL Server};SERVER=(local);DATABASE=ASSOAVIS_STORICO;Trusted_Connection=yes;TrustServerCertificate=yes

# Backup del DB (manage.py backup e chiusura di manage.py avvia). Vuoto = cartella backup/ nel progetto.
# I backup contengono dati personali e sanitari: meglio un disco cifrato o un supporto esterno
CARTELLA_BACKUP=
BACKUP_DA_TENERE=10
